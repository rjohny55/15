#!/bin/bash
# submit-tz: Submit revised implementation plan (Architect)
set -euo pipefail

AO_SESSION="${AO_SESSION:-}"
AO_API_PORT="${AO_API_PORT:-3000}"

if [ -z "$AO_SESSION" ]; then
  echo "Error: AO_SESSION environment variable not set" >&2
  exit 1
fi

# Step 1: Signal the Orchestrator
# Pass through role-specific arguments such as --approve/--reject.
PAYLOAD="{\"sessionId\": \"$AO_SESSION\"}"

response="$(curl -sS -w '\n%{http_code}' -X POST "http://localhost:$AO_API_PORT/api/events/plan/submit" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")" || {
  echo "[ao] submit-tz failed: could not reach orchestrator API" >&2
  exit 1
}

http_code="${response##*$'\n'}"
body="${response%$'\n'*}"

if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ] || ! printf '%s' "$body" | grep -q '"success"[[:space:]]*:[[:space:]]*true'; then
  echo "[ao] submit-tz failed: HTTP $http_code" >&2
  printf '%s\n' "$body" >&2
  exit 1
fi

echo "[ao] submit-tz recorded" >&2

exit 0
