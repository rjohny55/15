#!/bin/bash
# submit-assembly: Signal assembly completion (Assembler)
set -euo pipefail

AO_SESSION="${AO_SESSION:-}"
AO_API_PORT="${AO_API_PORT:-3000}"

if [ -z "$AO_SESSION" ]; then
  echo "Error: AO_SESSION environment variable not set" >&2
  exit 1
fi

    
    # Ensure there is at least one commit for the PR
    git add .
    git commit -m "chore: automated submission" --allow-empty 2>/dev/null || true
    
    # Step 1: Force push branch to remote (best effort)
    echo "[ao] Pushing branch to remote..." >&2
    current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [[ -n "$current_branch" && "$current_branch" != "HEAD" ]]; then
      git push origin "$current_branch" 2>/dev/null || true
    fi
    
# Step 2: Signal the Orchestrator
# Pass through role-specific arguments such as --approve/--reject.
PAYLOAD="{\"sessionId\": \"$AO_SESSION\", \"payload\": {\"args\": \"$*\"}}"

response="$(curl -sS -w '\n%{http_code}' -X POST "http://localhost:$AO_API_PORT/api/events/assembly/submit" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")" || {
  echo "[ao] submit-assembly failed: could not reach orchestrator API" >&2
  exit 1
}

http_code="${response##*$'\n'}"
body="${response%$'\n'*}"

if [ "$http_code" -lt 200 ] || [ "$http_code" -ge 300 ] || ! printf '%s' "$body" | grep -q '"success"[[:space:]]*:[[:space:]]*true'; then
  echo "[ao] submit-assembly failed: HTTP $http_code" >&2
  printf '%s\n' "$body" >&2
  exit 1
fi

echo "[ao] submit-assembly recorded" >&2

exit 0
